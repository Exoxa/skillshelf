# Copy this file to .env.local and fill in as each service is connected.
# Never commit .env.local. On Vercel, add the same names under Project Settings.

# --- Supabase (database, login, private video storage) ---
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server only. This key bypasses all database rules. Never expose it to the browser.
SUPABASE_SERVICE_ROLE_KEY=

# --- Paystack (payments) ---
NEXT_PUBLIC_PAYSTACK_PUBLIC_KEY=
# Server only. Also used to verify webhook signatures.
PAYSTACK_SECRET_KEY=

# --- Resend (welcome email) ---
RESEND_API_KEY=
EMAIL_FROM=

# --- App ---
NEXT_PUBLIC_SITE_URL=http://localhost:3000
